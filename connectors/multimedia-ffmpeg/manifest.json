{
  "id": "multimedia-ffmpeg",
  "name": "FFmpeg & ImageMagick Automation",
  "version": "0.1.0",
  "description": "Inspects, converts, compresses, and extracts media using ffprobe and ffmpeg.",
  "tier": "program_api",
  "transport": "stdio",
  "entrypoint": ["python3", "connector.py"],
  "dependencies": ["ffmpeg", "imagemagick"],
  "tools": [
    {
      "name": "inspect_media",
      "description": "Inspect resolution, codecs, duration, and bitrate of a media file via ffprobe.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Input media file path." }
        },
        "required": ["path"]
      }
    },
    {
      "name": "convert_media",
      "description": "Transcode or convert a media file to a new output path without overwriting existing files.",
      "risk_level": "write",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "input_path": { "type": "string" },
          "output_path": { "type": "string" },
          "preset": {
            "type": "string",
            "enum": ["balanced", "fast", "audio_only"],
            "default": "balanced"
          }
        },
        "required": ["input_path", "output_path"]
      }
    }
  ]
}
