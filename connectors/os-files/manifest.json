{
  "id": "os-files",
  "name": "AriaDE File Manager & OS File Operations",
  "version": "0.2.0",
  "description": "Controls filesystem operations: creates folders, writes files, deletes, copies, moves, searches files, finds duplicates, organizes directories, and opens folders in Thunar.",
  "tier": "program_api",
  "transport": "stdio",
  "entrypoint": [
    "python3",
    "connector.py"
  ],
  "dependencies": [
    "thunar",
    "ripgrep",
    "fd"
  ],
  "tools": [
    {
      "name": "scan_directory",
      "description": "Summarize file counts, sizes, and categories inside a directory.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Target directory path."
          },
          "recursive": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "search_files",
      "description": "Search files or directories by name glob/substring, minimum size, or text content.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Root directory to search."
          },
          "query": {
            "type": "string",
            "description": "Optional filename glob (e.g. '*.pdf') or case-insensitive substring."
          },
          "text_query": {
            "type": "string",
            "description": "Optional text content substring to match inside small text/code files."
          },
          "min_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "recursive": {
            "type": "boolean",
            "default": true
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "file_info",
      "description": "Inspect file or directory metadata: type, MIME type, size, permissions, modified time, and optional SHA-256.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File or directory path."
          },
          "include_hash": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "find_duplicates",
      "description": "Find exact duplicate files by size and SHA-256 hash.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory to scan."
          },
          "recursive": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "organize_directory",
      "description": "Plan or apply categorization of top-level files into Documents, Images, Videos, Audio, Archives, Code, and Other.",
      "risk_level": "write",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory to organize."
          },
          "apply": {
            "type": "boolean",
            "default": false,
            "description": "Set true to execute moves; false returns a dry-run plan."
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "move_to_trash",
      "description": "Safely move a file or directory to the FreeDesktop/Dolphin Trash (~/.local/share/Trash) so it can be restored.",
      "risk_level": "write",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File or directory to move to Trash."
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "open_in_dolphin",
      "description": "Open a directory or select a specific file inside KDE Dolphin file manager.",
      "risk_level": "write",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File or folder path to open in Dolphin."
          },
          "select_file": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "create_directory",
      "description": "Create a new directory or folder recursively.",
      "risk_level": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute or user path of the folder to create"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "write_file",
      "description": "Create or overwrite a file with given text content.",
      "risk_level": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path of the file to write"
          },
          "content": {
            "type": "string",
            "description": "Text content to write"
          },
          "append": {
            "type": "boolean",
            "description": "Append to file if true"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    {
      "name": "delete_path",
      "description": "Permanently delete a file or directory.",
      "risk_level": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path of file or folder to delete"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "copy_path",
      "description": "Copy a file or directory to a destination path.",
      "risk_level": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Source path"
          },
          "destination": {
            "type": "string",
            "description": "Destination path"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      }
    },
    {
      "name": "move_path",
      "description": "Move or rename a file or directory.",
      "risk_level": "write",
      "input_schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Source path"
          },
          "destination": {
            "type": "string",
            "description": "Destination path"
          }
        },
        "required": [
          "source",
          "destination"
        ]
      }
    }
  ]
}