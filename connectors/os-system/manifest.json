{
  "id": "os-system",
  "name": "OS System Health & Services",
  "version": "0.1.0",
  "description": "Monitors CPU, RAM, disk usage, top processes, and systemd service health on Arch Linux.",
  "tier": "os_ipc",
  "transport": "stdio",
  "entrypoint": ["python3", "connector.py"],
  "dependencies": ["systemd", "pacman"],
  "tools": [
    {
      "name": "system_health_summary",
      "description": "Read CPU load, memory, disk usage, uptime, and failed systemd units.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "list_top_processes",
      "description": "List top running processes sorted by memory or CPU usage.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "sort_by": {
            "type": "string",
            "enum": ["memory", "cpu"],
            "default": "memory"
          },
          "limit": {
            "type": "integer",
            "default": 10
          }
        },
        "required": []
      }
    },
    {
      "name": "service_status",
      "description": "Inspect the active state and recent journal logs of a systemd unit.",
      "risk_level": "read",
      "reversible": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "unit": { "type": "string", "description": "Systemd unit name (e.g. ollama.service)." },
          "lines": { "type": "integer", "default": 10 }
        },
        "required": ["unit"]
      }
    },
    {
      "name": "restart_service",
      "description": "Restart a systemd service (requires explicit confirmation).",
      "risk_level": "privileged",
      "reversible": false,
      "input_schema": {
        "type": "object",
        "properties": {
          "unit": { "type": "string" }
        },
        "required": ["unit"]
      }
    }
  ]
}
