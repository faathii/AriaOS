{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariaos.org/schemas/connector.schema.json",
  "title": "AriaOS Connector Manifest",
  "description": "Standard contract for every AriaOS application or OS-subsystem connector.",
  "type": "object",
  "required": ["id", "name", "version", "tier", "transport", "tools"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Unique lowercase connector identifier (matches directory name)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": ["os_ipc", "program_api", "ui_fallback"],
      "description": "Control tier: native OS IPC (D-Bus/systemd), program API/CLI, or UI fallback."
    },
    "transport": {
      "type": "string",
      "enum": ["stdio", "unix_socket", "dbus"],
      "description": "Communication channel between aria-daemon and this connector."
    },
    "entrypoint": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Command and arguments used by aria-daemon to launch stdio/socket connectors."
    },
    "socket_path": {
      "type": "string",
      "description": "Optional Unix socket path when transport is unix_socket."
    },
    "dbus_service": {
      "type": "string",
      "description": "Optional D-Bus well-known service name when transport is dbus."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "System binaries, packages, or services required by this connector."
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "risk_level", "input_schema"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": ["read", "write", "privileged"]
          },
          "reversible": {
            "type": "boolean",
            "default": false
          },
          "input_schema": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "const": "object" },
              "properties": { "type": "object" },
              "required": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

