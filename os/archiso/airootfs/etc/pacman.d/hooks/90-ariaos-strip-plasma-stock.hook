# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = plasma-welcome
Target = plasma-workspace

[Action]
Description = Replacing stock KDE plasmashell and plasma-welcome with AriaOS Cyber Obsidian Shell...
When = PostTransaction
Depends = sh
Depends = coreutils
Exec = /bin/sh -c "rm -f /etc/xdg/autostart/org.kde.plasma-welcome.desktop /usr/bin/plasma-welcome /usr/share/applications/org.kde.plasma-welcome.desktop; if [ -f /usr/bin/ariaos-shell ]; then cp -f /usr/bin/ariaos-shell /usr/bin/plasmashell && chmod 755 /usr/bin/plasmashell; fi"

