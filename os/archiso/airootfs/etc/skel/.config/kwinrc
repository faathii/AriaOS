[Compositing]
AllowTearing=true
Backend=OpenGL
GLCore=true
HiddenPreviews=5
LatencyPolicy=Low
OpenGLIsUnsafe=false
WindowsBlockCompositing=true

[Effect-blur]
BlurStrength=6
NoiseStrength=0

[org.kde.kwin.decoration]
BorderSize=Normal
BorderSizeAuto=false
ButtonsOnLeft=M
ButtonsOnRight=IAX
ShowToolTips=false
library=org.kde.kwin.aurorae
theme=__aurorae__svg__AriaCyberObsidian

[OrgKdeKDecoration2]
BorderSize=Normal
BorderSizeAuto=false
ButtonsOnLeft=M
ButtonsOnRight=IAX
ShowToolTips=false
library=org.kde.kwin.aurorae
theme=__aurorae__svg__AriaCyberObsidian

[Plugins]
blurEnabled=true
contrastEnabled=true
kwin4_effect_dimscreenEnabled=true
kwin4_effect_fadeEnabled=true
kwin4_effect_scaleEnabled=true
slideEnabled=true
wobblywindowsEnabled=false

[Windows]
BorderlessMaximizedWindows=false
ElectricBorderMaximize=true
ElectricBorderTiling=true
FocusPolicy=ClickToFocus
Placement=Centered
RollOverDesktops=true
