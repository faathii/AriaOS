[Unit]
Description=AriaOS Native AI Orchestration Daemon
After=network.target dbus.service ollama.service
Wants=ollama.service

[Service]
Type=simple
ExecStart=/usr/bin/aria-daemon
RuntimeDirectory=ariaos
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

