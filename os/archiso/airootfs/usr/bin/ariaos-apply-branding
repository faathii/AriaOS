#!/usr/bin/env bash
# AriaOS Native Desktop Branding & Theme Enforcer
# Ensures AriaOS Dark Obsidian theme and Openbox configurations are applied.

THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openbox"
mkdir -p "${THEME_DIR}"

if [ ! -f "${THEME_DIR}/rc.xml" ] && [ -f /etc/xdg/openbox/rc.xml ]; then
  cp -f /etc/xdg/openbox/rc.xml "${THEME_DIR}/rc.xml"
fi

if [ -f /usr/share/wallpapers/AriaOS/contents/images/2816x1536.jpg ] && command -v feh >/dev/null 2>&1; then
  feh --bg-fill /usr/share/wallpapers/AriaOS/contents/images/2816x1536.jpg 2>/dev/null || true
fi
