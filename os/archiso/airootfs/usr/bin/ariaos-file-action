#!/usr/bin/env python3
"""AriaOS Dolphin File Manager AI action launcher."""

from __future__ import annotations

import json
import shutil
import subprocess
import sys
from pathlib import Path

IPC_DIR = Path("/usr/lib/ariaos/command-bar")
if IPC_DIR.exists() and str(IPC_DIR) not in sys.path:
    sys.path.insert(0, str(IPC_DIR))


def _call_files(tool: str, args: dict, approved: bool = False) -> dict:
    try:
        from aria_ipc import AriaDaemonClient  # type: ignore

        client = AriaDaemonClient(timeout=120.0)
        if client.socket_path.exists():
            resp = client.call_tool("os-files", tool, args, approved=approved)
            if not resp.get("ok"):
                raise RuntimeError(resp.get("error", "aria-daemon call failed"))
            return resp["result"]
    except ImportError:
        pass

    proc = subprocess.run(
        ["aria-daemon", "call", "os-files", tool, json.dumps(args), "--yes"],
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        raise RuntimeError((proc.stderr or proc.stdout).strip())
    return json.loads(proc.stdout)


def _show_message(title: str, text: str) -> None:
    if shutil.which("kdialog"):
        subprocess.run(["kdialog", "--msgbox", text, "--title", title], check=False)
    elif shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "AriaOS Files", "-i", "ariaos-logo", title, text], check=False)
    else:
        print(f"{title}\n{text}")


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("Usage: ariaos-file-action <organize|duplicates> <directory>", file=sys.stderr)
        return 2

    action = argv[0]
    target = str(Path(argv[1]).expanduser().resolve())

    if action == "organize":
        try:
            data = _call_files("organize_directory", {"path": target, "apply": False}, approved=True)
        except Exception as exc:
            _show_message("AriaOS Gestor de Archivos", str(exc))
            return 1
        moves = data.get("moves", [])
        if not moves:
            _show_message("AriaOS Organizador IA", f"No hay archivos pendientes de organizar en:\n{target}")
            return 0
        preview = "\n".join(f"• {Path(m['source']).name} -> {Path(m['destination']).parent.name}/" for m in moves[:20])
        extra = f"\n... y {len(moves) - 20} más." if len(moves) > 20 else ""
        prompt = f"Vista previa en {target} ({len(moves)} archivos):\n\n{preview}{extra}\n\n¿Aplicar esta organización ahora?"
        if shutil.which("kdialog"):
            if subprocess.run(["kdialog", "--yesno", prompt, "--title", "AriaOS Organizador IA"]).returncode == 0:
                _call_files("organize_directory", {"path": target, "apply": True}, approved=True)
                _show_message("AriaOS Organizador IA", f"Carpeta organizada correctamente ({len(moves)} archivo(s) movidos).")
        else:
            print(prompt)
        return 0

    if action == "duplicates":
        try:
            groups = _call_files("find_duplicates", {"path": target, "recursive": True}).get("duplicate_groups", [])
        except Exception as exc:
            _show_message("AriaOS Buscador de Duplicados", str(exc))
            return 1
        if not groups:
            _show_message("AriaOS Buscador de Duplicados", f"No se encontraron archivos duplicados en:\n{target}")
            return 0
        lines = []
        for idx, group in enumerate(groups[:10], start=1):
            lines.append(f"Grupo {idx} ({group['size_bytes']} bytes):")
            for path in group["files"]:
                lines.append(f"  - {path}")
        _show_message("AriaOS Buscador de Duplicados", f"Se encontraron {len(groups)} grupo(s) de duplicados:\n\n" + "\n".join(lines))
        return 0

    print(f"Unknown action: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

