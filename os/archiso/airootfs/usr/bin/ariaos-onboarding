#!/usr/bin/env bash
# AriaOS Lightweight System Onboarding (Zero RAM bloat on Live ISO)
set -euo pipefail

MARKER="/var/lib/ariaos/.onboarding-complete"
[ -f "${MARKER}" ] && exit 0

mkdir -p /var/lib/ariaos/quarantine
chmod 700 /var/lib/ariaos/quarantine || true

# 1. Apply kernel performance & memory pressure sysctls immediately
sysctl --system >/dev/null 2>&1 || true

# 2. Configure ClamAV exclusions without starting heavy background daemons in RAM
if [ -x /usr/bin/ariaos-clamav-sync ]; then
  /usr/bin/ariaos-clamav-sync || true
fi

# 3. Register pre-packaged Aria Neural Model (aria-core) if local weights exist
MODELFILE="/usr/share/ariaos/models/Modelfile.aria-core"
if systemctl is-active --quiet ollama.service && [ -f "${MODELFILE}" ]; then
  if ollama list 2>/dev/null | grep -q "qwen2.5:0.5b"; then
    ollama create aria-core -f "${MODELFILE}" >/dev/null 2>&1 || true
  fi
fi

date -Iseconds > "${MARKER}"
echo "AriaOS Neural Core & Kernel Onboarding complete."
