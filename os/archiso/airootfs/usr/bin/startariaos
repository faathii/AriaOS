#!/usr/bin/env bash
# AriaOS Native Desktop Session Launcher (AriaDE)
# Completely independent from KDE Plasma. Runs Picom + Openbox + AriaOS Native Shell.

export XDG_CURRENT_DESKTOP="AriaOS"
export XDG_SESSION_DESKTOP="ariaos"
export XDG_SESSION_TYPE="x11"
export QT_QPA_PLATFORM="xcb"
export QT_AUTO_SCREEN_SCALE_FACTOR="1"
export PYTHONPATH="/usr/lib/ariaos/core/sdk/python:${PYTHONPATH:-}"

# Ensure D-Bus session bus is active
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# Set optimal resolution on VirtualBox / VM displays if currently at small fallback
if command -v xrandr >/dev/null 2>&1; then
  OUT_DEV="$(xrandr | awk '/ connected/{print $1; exit}')"
  if [ -n "${OUT_DEV}" ]; then
    xrandr --output "${OUT_DEV}" --mode 1360x768 2>/dev/null || \
    xrandr --output "${OUT_DEV}" --mode 1280x800 2>/dev/null || \
    xrandr --output "${OUT_DEV}" --preferred 2>/dev/null || true
  fi
fi

# Disable screen blanking in live session
if command -v xset >/dev/null 2>&1; then
  xset s off -dpms 2>/dev/null || true
  xsetroot -solid "#0c0f17" 2>/dev/null || true
fi

# Start Picom compositor (uses config in /etc/xdg/picom.conf with reliable xrender backend)
if command -v picom >/dev/null 2>&1; then
  picom -b --config /etc/xdg/picom.conf 2>/dev/null || true
fi

# Start Openbox Window Manager with AriaCupertino theme
if command -v openbox >/dev/null 2>&1; then
  openbox --config-file /etc/xdg/openbox/rc.xml &
fi

# Start Polkit agent if available
for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/lib/polkit-kde-authentication-agent-1; do
  if [ -x "${agent}" ]; then
    "${agent}" >/dev/null 2>&1 &
    break
  fi
done

# Start the AriaOS Native Desktop Shell as the primary session process with logging and failsafe
exec /usr/bin/ariaos-shell >> /tmp/ariaos-session.log 2>&1 || {
  echo "[startariaos] Shell exited, maintaining fallback session..." >> /tmp/ariaos-session.log
  while true; do sleep 3600; done
}
