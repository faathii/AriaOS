# Maintainer: AriaOS Contributors <https://github.com/faathii/AriaOS>
pkgname=ariaos-core
pkgver=0.1.0
pkgrel=1
pkgdesc="AriaOS native AI daemon, Python connector SDK, and ecosystem app connectors"
arch=('x86_64')
url="https://github.com/faathii/AriaOS"
license=('GPL-3.0-or-later')
depends=('python' 'ollama' 'systemd' 'dbus')
makedepends=('cargo' 'rust')

build() {
  local root_dir
  root_dir="$(cd "${startdir}/../.." && pwd)"
  cargo build --release --manifest-path "${root_dir}/core/daemon/Cargo.toml" --target-dir "${srcdir}/target"
}

package() {
  local root_dir
  root_dir="$(cd "${startdir}/../.." && pwd)"
  install -Dm755 "${srcdir}/target/release/aria-daemon" "${pkgdir}/usr/bin/aria-daemon"
  install -Dm644 "${root_dir}/os/archiso/airootfs/etc/systemd/system/aria-daemon.service" \
    "${pkgdir}/usr/lib/systemd/system/aria-daemon.service"

  install -d "${pkgdir}/usr/lib/ariaos/core/sdk/python"
  cp -a "${root_dir}/core/sdk/python/aria_sdk" "${pkgdir}/usr/lib/ariaos/core/sdk/python/"
  install -d "${pkgdir}/usr/lib/ariaos/connectors"
  cp -a "${root_dir}/connectors/." "${pkgdir}/usr/lib/ariaos/connectors/"
}
